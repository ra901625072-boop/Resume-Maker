# ============================================================
# WISAXIS Resume Maker — Environment Configuration (.env)
# ============================================================

# Flask Environment: development | production | testing
FLASK_ENV=development
FLASK_DEBUG=true

# Port (default: 5050)
PORT=5050

# Application Secret Key
SECRET_KEY=change-me-in-production-random-secret-key-123456789

# Database Connection URL:
# 1. Default (Local SQLite): Leave blank or comment out
# DATABASE_URL=sqlite:///instance/wisaxis.db

# 2. Render PostgreSQL (External URL for Local Dev / Internal URL for Render Web Service):
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>
DATABASE_URL=

# OpenRouter AI API Key (Get a free key from https://openrouter.ai)
OPENROUTER_API_KEY=

# CORS Allowed Origins (Comma-separated)
# CORS_ORIGINS=https://resume-maker-five-bice.vercel.app,http://localhost:3000