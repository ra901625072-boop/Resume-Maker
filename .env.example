# =====================================================================
#  WISAXIS Resume Maker — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# =====================================================================

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5050

# ── Security ───────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (default — zero setup, stored in instance/wisaxis.db)
# DATABASE_URL=sqlite:///instance/wisaxis.db

# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://user:password@host:5432/wisaxis_db

# ── OpenRouter AI ──────────────────────────────────────────────────────────
# Sign up at https://openrouter.ai → API Keys → Create key
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Primary AI Model (Multimodal & Fast Reasoning):
AI_MODEL_PRIMARY=google/gemini-2.0-flash-001

# Multimodal / Vision models for document OCR & images (comma-separated fallback list):
AI_MODEL_VISION=google/gemini-2.0-flash-001,qwen/qwen-2.5-vl-72b-instruct:free,meta-llama/llama-3.2-11b-vision-instruct:free,mistralai/pixtral-12b:free,openrouter/free

# Secondary / Text reasoning model (fallback):
AI_MODEL_SECONDARY=meta-llama/llama-3.3-70b-instruct:free

# Emergency fallback model:
AI_MODEL_EMERGENCY=mistralai/mistral-7b-instruct:free

# AI request timeout in seconds
AI_REQUEST_TIMEOUT=45

# Maximum tokens per AI response (supports full document JSON)
AI_MAX_TOKENS=4096

# ── Rate Limiting ───────────────────────────────────────────────────────────
# Use in-memory by default. Switch to Redis for multi-worker deployments:
# REDIS_URL=redis://localhost:6379/0

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS (required for Vercel frontend → Render backend) ────────────────────
# Comma-separated list of allowed frontend origins
# CORS_ORIGINS=https://your-app.vercel.app

# ── Cross-Site Cookies (required when frontend and backend are on different domains)
# SESSION_COOKIE_SAMESITE=None
# REMEMBER_COOKIE_SAMESITE=None

# ── Optional: Sentry error tracking ─────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
