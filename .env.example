# =====================================================================
#  WISAXIS Resume Maker — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# =====================================================================

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5050

# ── Security ───────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (default — zero setup, stored in instance/wisaxis.db)
# DATABASE_URL=sqlite:///instance/wisaxis.db

# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://user:password@host:5432/wisaxis_db

# ── OpenRouter AI ──────────────────────────────────────────────────────────
# Sign up at https://openrouter.ai → API Keys → Create key
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Primary AI Model (Auto-routing fast model):
AI_MODEL_PRIMARY=openrouter/free

# Multimodal / Vision models for document OCR & images (comma-separated fallback list):
AI_MODEL_VISION=openrouter/free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-12b-v2-vl:free,dots-studio/dots-3-note-preview:free

# Secondary / Text reasoning model (fallback):
AI_MODEL_SECONDARY=google/gemma-4-26b-a4b-it:free

# Emergency fallback model:
AI_MODEL_EMERGENCY=nvidia/nemotron-3.5-lightning:free

# AI request timeout in seconds per model attempt
AI_REQUEST_TIMEOUT=18

# Maximum tokens per AI response (supports full document JSON)
AI_MAX_TOKENS=4096

# ── Rate Limiting ───────────────────────────────────────────────────────────
# Use in-memory by default. Switch to Redis for multi-worker deployments:
# REDIS_URL=redis://localhost:6379/0

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS (required for Vercel frontend → Render backend) ────────────────────
# Comma-separated list of allowed frontend origins
# CORS_ORIGINS=https://your-app.vercel.app

# ── Cross-Site Cookies (required when frontend and backend are on different domains)
# SESSION_COOKIE_SAMESITE=None
# REMEMBER_COOKIE_SAMESITE=None

# ── Optional: Sentry error tracking ─────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
