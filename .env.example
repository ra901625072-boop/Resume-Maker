# =====================================================================
#  WISAXIS Resume Maker — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# =====================================================================

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5050

# ── Security ───────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (default — zero setup, stored in instance/wisaxis.db)
# DATABASE_URL=sqlite:///instance/wisaxis.db

# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://user:password@host:5432/wisaxis_db

# ── OpenRouter AI ──────────────────────────────────────────────────────────
# Sign up at https://openrouter.ai → API Keys → Create key
# Free models available: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=your-openrouter-api-key-here

# AI model to use (see https://openrouter.ai/models)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# AI request timeout in seconds
AI_REQUEST_TIMEOUT=30

# Maximum tokens per AI response
AI_MAX_TOKENS=1024

# ── Rate Limiting ───────────────────────────────────────────────────────────
# Use in-memory by default. Switch to Redis for multi-worker deployments:
# REDIS_URL=redis://localhost:6379/0

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS (required for Vercel frontend → Render backend) ────────────────────
# Comma-separated list of allowed frontend origins
# CORS_ORIGINS=https://your-app.vercel.app

# ── Cross-Site Cookies (required when frontend and backend are on different domains)
# SESSION_COOKIE_SAMESITE=None
# REMEMBER_COOKIE_SAMESITE=None

# ── Optional: Sentry error tracking ─────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
