# ============================================================
# WISAXIS Resume Maker — Environment Configuration (.env)
# ============================================================

# Flask Environment: development | production | testing
FLASK_ENV=development
FLASK_DEBUG=true

# Port (default: 5050)
PORT=5050

# Application Secret Key
SECRET_KEY=change-me-in-production-random-secret-key-123456789

# Database Connection URL:
# 1. Local PC -> Render PostgreSQL (External URL with SSL):
# DATABASE_URL=postgresql://<user>:<password>@<host>.render.com/<dbname>?sslmode=require

# 2. Render Web Service -> Render PostgreSQL (Internal URL for Render Dashboard):
# DATABASE_URL=postgresql://<user>:<password>@<internal_host>/<dbname>

# 3. Local SQLite (Default fallback if left empty):
# DATABASE_URL=sqlite:///instance/wisaxis.db
DATABASE_URL=

# OpenRouter AI API Key (Get a free key from https://openrouter.ai)
OPENROUTER_API_KEY=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://resume-maker-five-bice.vercel.app,http://localhost:3000,http://localhost:5050
